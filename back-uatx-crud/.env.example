# Copia este archivo como .env y completa los valores (el .env no se sube a git).

# Puerto de la API (opcional, por defecto 3000)
PORT=3000

# Origen del frontend permitido por CORS (opcional, por defecto el dev server de Vite)
CORS_ORIGIN=http://localhost:5173

# Supabase — Project Settings > API
SUPABASE_URL=https://zqzqjtwmanroqcuhqois.supabase.co
SUPABASE_ANON_KEY=
# Service role key: SOLO backend, nunca exponer al frontend
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — https://aistudio.google.com/apikey (SOLO backend, nunca exponer al frontend)
# Sin estas variables el backend arranca, pero las rutas de /accidentes responden 503
GEMINI_API_KEY=
# Modelo que acepte imágenes y salida estructurada (p. ej. gemini-2.5-flash)
GEMINI_MODEL=

# Secreto para firmar las constancias de las fotos analizadas (HMAC-SHA256)
# Genera uno con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CONSTANCIA_SECRET=
